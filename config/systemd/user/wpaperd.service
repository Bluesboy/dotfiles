[Unit]
Description=Modern wallpaper daemon for Wayland
Documentation=https://github.com/danyspin97/wpaperd
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
# wpaperd 1.3.0 segfaults inside Mesa when an output is removed and re-added.
# The monitors drop their HDMI link about ten seconds after DPMS off, which
# destroys the wl_surface while events for it are still queued. Upstream fixed
# this after the 1.3.0 release, so restarting is the workaround. The limits
# tolerate a burst of hotplug churn but still give up on a real boot loop.
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=simple
ExecStart=/usr/bin/wpaperd
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
